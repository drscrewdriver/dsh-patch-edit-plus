{
  "name": "dsh-patch-edit-plus",
  "version": "0.1.0",
  "description": "Patch-style file editing for DeepSeek Harness: one apply_patch tool accepting git/unified diff (default) and Codex apply_patch syntax (opt-in), with all-or-nothing application, read-before-write intent dance, sandbox-aware delete/move, and 0.1.2-rc.1 ~ 0.1.5-rc.2 compatibility.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drscrewdriver/dsh-patch-edit-plus.git"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "screenshots.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "LICENSE",
    "assets/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:0.1.5": "node scripts/typecheck-0.1.5.mjs",
    "lint": "eslint src tests scripts _smoke",
    "lint:fix": "eslint src tests scripts _smoke --fix",
    "test": "vitest run",
    "verify:source": "node scripts/verify-source.mjs",
    "smoke": "node _smoke/load-smoke.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\""
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.2-rc.1 <0.2.0-0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "apply-patch",
    "unified-diff",
    "codex",
    "patch",
    "edit"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-shell": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-fs": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.2-rc.1",
    "@deepseek-ai/dsh-shell": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
